<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel>
          <TextBlock Classes="title" Text="Title"/>
          <TextBlock Classes="subtitle" Text="Subtitle"/>
          <TextBlock Classes="header" Text="Header"/>
          <TextBlock Classes="value" Text="Values"/>
          <TextBlock Classes="meta" Text="Meta"/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>
       <Style Selector="TextBlock.header">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="6"/>

    </Style>
    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="TextBlock.meta">
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="5"/>
    </Style>

       <!-- Small -->
    <Style Selector="Border.drop-s">
        <Setter Property="BoxShadow" Value="0 2 6 0 #33000000"/>
    </Style>

    <!-- Medium -->
    <Style Selector="Border.drop-m">
        <Setter Property="BoxShadow" Value="0 4 12 0 #55000000"/>
    </Style>

    <!-- Large -->
    <Style Selector="Border.drop-l">
        <Setter Property="BoxShadow" Value="0 8 24 0 #88000000"/>
    </Style>
  <!-- Add Styles Here -->
</Styles>

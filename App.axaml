<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TitanControl.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme DensityStyle="Compact"/>
        <StyleInclude Source="avares://TitanControl/Styles/Application.axaml"/>
        <StyleInclude Source="avares://TitanControl/Styles/Common.axaml"/>
        <StyleInclude Source="avares://TitanControl/Styles/Navigation.axaml"/>

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://TitanControl/Resources/Fonts.axaml"/>
                <ResourceInclude Source="avares://TitanControl/Resources/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
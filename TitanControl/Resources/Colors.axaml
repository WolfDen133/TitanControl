<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <UniformGrid Columns="2">
                        <UniformGrid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                </Style>
            </UniformGrid.Styles>

            <!-- Header -->
            <TextBlock Text="Color"
                       FontWeight="Bold"
                       FontSize="12"
                       Background="{DynamicResource BackgroundDDBrush}"/>

            <TextBlock Text="Brush"
                       FontWeight="Bold"
                       FontSize="12"
                       Background="{DynamicResource BackgroundDDBrush}"/>

            <!-- Background -->
            <TextBlock Text="BackgroundDD"
                       Background="{DynamicResource BackgroundDDBrush}"/>

            <TextBlock Text="BackgroundDDBrush"
                       Background="{DynamicResource BackgroundDDBrush}"/>

            <TextBlock Text="BackgroundD"
                       Background="{DynamicResource BackgroundDBrush}"/>

            <TextBlock Text="BackgroundDBrush"
                       Background="{DynamicResource BackgroundDBrush}"/>

            <TextBlock Text="Background"
                       Background="{DynamicResource BackgroundBrush}"/>

            <TextBlock Text="BackgroundBrush"
                       Background="{DynamicResource BackgroundBrush}"/>

            <TextBlock Text="BackgroundL"
                       Background="{DynamicResource BackgroundLBrush}"/>

            <TextBlock Text="BackgroundLBrush"
                       Background="{DynamicResource BackgroundLBrush}"/>

            <TextBlock Text="BackgroundLL"
                       Background="{DynamicResource BackgroundLLBrush}"/>

            <TextBlock Text="BackgroundLLBrush"
                       Background="{DynamicResource BackgroundLLBrush}"/>

            <!-- Buttons -->
            <TextBlock Text="ButtonBackground"
                       Background="{DynamicResource ButtonBackgroundBrush}"/>

            <TextBlock Text="ButtonBackgroundBrush"
                       Background="{DynamicResource ButtonBackgroundBrush}"/>

            <TextBlock Text="ButtonBackgroundHover"
                       Background="{DynamicResource ButtonBackgroundHoverBrush}"/>

            <TextBlock Text="ButtonBackgroundHoverBrush"
                       Background="{DynamicResource ButtonBackgroundHoverBrush}"/>

            <TextBlock Text="ButtonBackgroundPressed"
                       Background="{DynamicResource ButtonBackgroundPressedBrush}"/>

            <TextBlock Text="ButtonBackgroundPressedBrush"
                       Background="{DynamicResource ButtonBackgroundPressedBrush}"/>

            <!-- Foreground -->
            <TextBlock Text="Foreground"
                       Background="{DynamicResource ForegroundBrush}"
                       Foreground="{DynamicResource BackgroundDDBrush}"/>

            <TextBlock Text="ForegroundBrush"
                       Background="{DynamicResource ForegroundBrush}"
                       Foreground="{DynamicResource BackgroundDDBrush}"/>

            <TextBlock Text="ForegroundSecondary"
                       Background="{DynamicResource ForegroundSecondaryBrush}"
                       Foreground="{DynamicResource BackgroundDDBrush}"/>

            <TextBlock Text="ForegroundSecondaryBrush"
                       Background="{DynamicResource ForegroundSecondaryBrush}"
                       Foreground="{DynamicResource BackgroundDDBrush}"/>

            <TextBlock Text="ForegroundDisabled"
                       Background="{DynamicResource ForegroundDisabledBrush}"/>

            <TextBlock Text="ForegroundDisabledBrush"
                       Background="{DynamicResource ForegroundDisabledBrush}"/>

            <TextBlock Text="ForegroundPlaceholder"
                       Background="{DynamicResource ForegroundPlaceholderBrush}"/>

            <TextBlock Text="ForegroundPlaceholderBrush"
                       Background="{DynamicResource ForegroundPlaceholderBrush}"/>

            <!-- Accent -->
            <TextBlock Text="AccentColorD"
                       Background="{DynamicResource AccentDBrush}"/>

            <TextBlock Text="AccentDBrush"
                       Background="{DynamicResource AccentDBrush}"/>

            <TextBlock Text="AccentColor"
                       Background="{DynamicResource AccentBrush}"/>

            <TextBlock Text="AccentBrush"
                       Background="{DynamicResource AccentBrush}"/>

            <TextBlock Text="AccentColorL"
                       Background="{DynamicResource AccentLBrush}"/>

            <TextBlock Text="AccentLBrush"
                       Background="{DynamicResource AccentLBrush}"/>

            <TextBlock Text="AccentColorLL"
                       Background="{DynamicResource AccentLLBrush}"/>

            <TextBlock Text="AccentLLBrush"
                       Background="{DynamicResource AccentLLBrush}"
                       />

            <!-- Borders -->
            <TextBlock Text="BorderSubtle"
                       Background="{DynamicResource BorderSubtleBrush}"/>

            <TextBlock Text="BorderSubtleBrush"
                       Background="{DynamicResource BorderSubtleBrush}"/>

            <TextBlock Text="Border"
                       Background="{DynamicResource BorderBrush}"/>

            <TextBlock Text="BorderBrush"
                       Background="{DynamicResource BorderBrush}"/>

            <TextBlock Text="BorderFocus"
                       Background="{DynamicResource BorderFocusBrush}"/>

            <TextBlock Text="BorderFocusBrush"
                       Background="{DynamicResource BorderFocusBrush}"/>

            <TextBlock Text="Divider"
                       Background="{DynamicResource DividerBrush}"/>

            <TextBlock Text="DividerBrush"
                       Background="{DynamicResource DividerBrush}"/>

            <!-- Success -->
            <TextBlock Text="SuccessColorD"
                       Background="{DynamicResource SuccessDBrush}"/>

            <TextBlock Text="SuccessDBrush"
                       Background="{DynamicResource SuccessDBrush}"/>

            <TextBlock Text="SuccessColor"
                       Background="{DynamicResource SuccessBrush}"/>

            <TextBlock Text="SuccessBrush"
                       Background="{DynamicResource SuccessBrush}"/>

            <TextBlock Text="SuccessColorL"
                       Background="{DynamicResource SuccessLBrush}"/>

            <TextBlock Text="SuccessLBrush"
                       Background="{DynamicResource SuccessLBrush}"/>

            <!-- Warning -->
            <TextBlock Text="WarningColorD"
                       Background="{DynamicResource WarningDBrush}"/>

            <TextBlock Text="WarningDBrush"
                       Background="{DynamicResource WarningDBrush}"/>

            <TextBlock Text="WarningColor"
                       Background="{DynamicResource WarningBrush}"/>

            <TextBlock Text="WarningBrush"
                       Background="{DynamicResource WarningBrush}"/>

            <TextBlock Text="WarningColorL"
                       Background="{DynamicResource WarningLBrush}"/>

            <TextBlock Text="WarningLBrush"
                       Background="{DynamicResource WarningLBrush}"/>

            <!-- Danger -->
            <TextBlock Text="DangerColorD"
                       Background="{DynamicResource DangerDBrush}"/>

            <TextBlock Text="DangerDBrush"
                       Background="{DynamicResource DangerDBrush}"/>

            <TextBlock Text="DangerColor"
                       Background="{DynamicResource DangerBrush}"/>

            <TextBlock Text="DangerBrush"
                       Background="{DynamicResource DangerBrush}"/>

            <TextBlock Text="DangerColorL"
                       Background="{DynamicResource DangerLBrush}"/>

            <TextBlock Text="DangerLBrush"
                       Background="{DynamicResource DangerLBrush}"/>

            <!-- Selection -->
            <TextBlock Text="SelectionColor"
                       Background="{DynamicResource SelectionBrush}"/>

            <TextBlock Text="SelectionBrush"
                       Background="{DynamicResource SelectionBrush}"/>

            <TextBlock Text="SelectionColorL"
                       Background="{DynamicResource SelectionLBrush}"/>

            <TextBlock Text="SelectionLBrush"
                       Background="{DynamicResource SelectionLBrush}"/>

            <TextBlock Text="SelectionFocus"
                       Background="{DynamicResource SelectionFocusBrush}"/>

            <TextBlock Text="SelectionFocusBrush"
                       Background="{DynamicResource SelectionFocusBrush}"/>

            <TextBlock Text="SelectionTranslucent"
                       Background="{DynamicResource SelectionTranslucentBrush}"/>

            <TextBlock Text="SelectionTranslucentBrush"
                       Background="{DynamicResource SelectionTranslucentBrush}"/>

            <!-- Shadows -->
            <TextBlock Text="ShadowSoft"
                       Background="{DynamicResource ShadowSoftBrush}"/>

            <TextBlock Text="ShadowSoftBrush"
                       Background="{DynamicResource ShadowSoftBrush}"/>

            <TextBlock Text="ShadowMedium"
                       Background="{DynamicResource ShadowMediumBrush}"/>

            <TextBlock Text="ShadowMediumBrush"
                       Background="{DynamicResource ShadowMediumBrush}"/>

            <TextBlock Text="ShadowHeavy"
                       Background="{DynamicResource ShadowHeavyBrush}"/>

            <TextBlock Text="ShadowHeavyBrush"
                       Background="{DynamicResource ShadowHeavyBrush}"/>

            <TextBlock Text="TitanCueBrush"
                       Background="{StaticResource TitanCueBrush}"/>

            <TextBlock Text="TitanPaletteBrush"
                       Background="{StaticResource TitanPaletteBrush}"/>

            <TextBlock Text="TitanFixtureBrush"
                       Background="{StaticResource TitanFixtureBrush}"/>

            <TextBlock Text="TitanMasterBrush"
                       Background="{StaticResource TitanMasterBrush}"/>

            <TextBlock Text="TitanMacroBrush"
                       Background="{StaticResource TitanMacroBrush}"/>

            <TextBlock Text="TitanGroupBrush"
                       Background="{StaticResource TitanGroupBrush}"/>

            <TextBlock Text="TitanSceneBrush"
                       Background="{StaticResource TitanSceneBrush}"/>
        </UniformGrid>
    </Design.PreviewWith>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- ========================= -->
            <!-- Background -->
            <!-- ========================= -->

            <Color x:Key="BackgroundDD">#0e1214</Color>
            <Color x:Key="BackgroundD">#111617</Color>
            <Color x:Key="Background">#14191c</Color>
            <Color x:Key="BackgroundL">#1b2023</Color>
            <Color x:Key="BackgroundLL">#242a30</Color>
            <Color x:Key="ButtonBackground">#39434E</Color>
            <Color x:Key="ButtonBackgroundHover">#465463</Color>
            <Color x:Key="ButtonBackgroundPressed">#55687A</Color>

            <SolidColorBrush x:Key="BackgroundDDBrush" Color="{DynamicResource BackgroundDD}" />
            <SolidColorBrush x:Key="BackgroundDBrush" Color="{DynamicResource BackgroundD}" />
            <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource Background}" />
            <SolidColorBrush x:Key="BackgroundLBrush" Color="{DynamicResource BackgroundL}" />
            <SolidColorBrush x:Key="BackgroundLLBrush" Color="{DynamicResource BackgroundLL}" />
            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ButtonBackground}" />
            <SolidColorBrush x:Key="ButtonBackgroundHoverBrush" Color="{DynamicResource ButtonBackgroundHover}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressedBrush" Color="{DynamicResource ButtonBackgroundPressed}" />

            <!-- ========================= -->
            <!-- Foreground -->
            <!-- ========================= -->

            <Color x:Key="Foreground">#F5F7FA</Color>
            <Color x:Key="ForegroundSecondary">#C8D0D8</Color>
            <Color x:Key="ForegroundDisabled">#7E8792</Color>
            <Color x:Key="ForegroundPlaceholder">#5D6772</Color>

            <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource Foreground}" />
            <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="{DynamicResource ForegroundSecondary}" />
            <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="{DynamicResource ForegroundDisabled}" />
            <SolidColorBrush x:Key="ForegroundPlaceholderBrush" Color="{DynamicResource ForegroundPlaceholder}" />

            <!-- ========================= -->
            <!-- Accent -->
            <!-- ========================= -->

            <Color x:Key="AccentColorD">#285EBF</Color>
            <Color x:Key="AccentColor">#3B82F6</Color>
            <Color x:Key="AccentColorL">#5D9EFF</Color>
            <Color x:Key="AccentColorLL">#8BBEFF</Color>

            <SolidColorBrush x:Key="AccentDBrush" Color="{DynamicResource AccentColorD}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
            <SolidColorBrush x:Key="AccentLBrush" Color="{DynamicResource AccentColorL}" />
            <SolidColorBrush x:Key="AccentLLBrush" Color="{DynamicResource AccentColorLL}" />

            <!-- ========================= -->
            <!-- Borders -->
            <!-- ========================= -->

            <Color x:Key="BorderSubtle">#343B44</Color>
            <Color x:Key="Border">#4A5562</Color>
            <Color x:Key="BorderFocus">#3B82F6</Color>
            <Color x:Key="Divider">#2B3138</Color>

            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource BorderSubtle}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource Border}" />
            <SolidColorBrush x:Key="BorderFocusBrush" Color="{DynamicResource BorderFocus}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource Divider}" />

            <!-- ========================= -->
            <!-- Success -->
            <!-- ========================= -->

            <Color x:Key="SuccessColorD">#0F6D3E</Color>
            <Color x:Key="SuccessColor">#1FA463</Color>
            <Color x:Key="SuccessColorL">#55D08A</Color>

            <SolidColorBrush x:Key="SuccessDBrush" Color="{DynamicResource SuccessColorD}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
            <SolidColorBrush x:Key="SuccessLBrush" Color="{DynamicResource SuccessColorL}" />

            <!-- ========================= -->
            <!-- Warning -->
            <!-- ========================= -->

            <Color x:Key="WarningColorD">#A56900</Color>
            <Color x:Key="WarningColor">#F4A000</Color>
            <Color x:Key="WarningColorL">#FFC14A</Color>

            <SolidColorBrush x:Key="WarningDBrush" Color="{DynamicResource WarningColorD}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
            <SolidColorBrush x:Key="WarningLBrush" Color="{DynamicResource WarningColorL}" />

            <!-- ========================= -->
            <!-- Danger -->
            <!-- ========================= -->

            <Color x:Key="DangerColorD">#A1272D</Color>
            <Color x:Key="DangerColor">#E5484D</Color>
            <Color x:Key="DangerColorL">#FF7A80</Color>

            <SolidColorBrush x:Key="DangerDBrush" Color="{DynamicResource DangerColorD}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
            <SolidColorBrush x:Key="DangerLBrush" Color="{DynamicResource DangerColorL}" />

            <!-- ========================= -->
            <!-- Selection -->
            <!-- ========================= -->

            <Color x:Key="SelectionColor">#294E87</Color>
            <Color x:Key="SelectionColorL">#3564AA</Color>
            <Color x:Key="SelectionFocus">#68A8FF</Color>
            <Color x:Key="SelectionTranslucent">#7f68A8FF</Color>


            <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" />
            <SolidColorBrush x:Key="SelectionLBrush" Color="{DynamicResource SelectionColorL}" />
            <SolidColorBrush x:Key="SelectionFocusBrush" Color="{DynamicResource SelectionFocus}" />
            <SolidColorBrush x:Key="SelectionTranslucentBrush" Color="{DynamicResource SelectionTranslucent}"/>
            <!-- ========================= -->
            <!-- Shadows -->
            <!-- ========================= -->

            <Color x:Key="ShadowSoft">#33000000</Color>
            <Color x:Key="ShadowMedium">#55000000</Color>
            <Color x:Key="ShadowHeavy">#88000000</Color>

            <SolidColorBrush x:Key="ShadowSoftBrush" Color="{DynamicResource ShadowSoft}" />
            <SolidColorBrush x:Key="ShadowMediumBrush" Color="{DynamicResource ShadowMedium}" />
            <SolidColorBrush x:Key="ShadowHeavyBrush" Color="{DynamicResource ShadowHeavy}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <!-- ========================= -->
    <!-- Titan Colors -->
    <!-- ========================= -->

    <!-- Cue -->
    <LinearGradientBrush
        x:Key="TitanCueBrush"
        StartPoint="50%,0%"
        EndPoint="50%,100%">
        <GradientStop Color="#46796C" Offset="0"/>
        <GradientStop Color="#354841" Offset="1"/>
    </LinearGradientBrush>

    <!-- Palette -->
    <LinearGradientBrush
        x:Key="TitanPaletteBrush"
        StartPoint="50%,0%"
        EndPoint="50%,100%">
        <GradientStop Color="#444A69" Offset="0"/>
        <GradientStop Color="#2E2A3E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Fixture -->
    <LinearGradientBrush
        x:Key="TitanFixtureBrush"
        StartPoint="50%,0%"
        EndPoint="50%,100%">
        <GradientStop Color="#3C4261" Offset="0"/>
        <GradientStop Color="#262236" Offset="1"/>
    </LinearGradientBrush>

    <!-- Macro -->
    <LinearGradientBrush
        x:Key="TitanMacroBrush"
        StartPoint="50%,0%"
        EndPoint="50%,100%">
        <GradientStop Color="#788690" Offset="0"/>
        <GradientStop Color="#2F3439" Offset="1"/>
    </LinearGradientBrush>

    <!-- Master -->
    <LinearGradientBrush
        x:Key="TitanMasterBrush"
        StartPoint="50%,0%"
        EndPoint="50%,100%">
        <GradientStop Color="#C5B917" Offset="0"/>
        <GradientStop Color="#AB5110" Offset="1"/>
    </LinearGradientBrush>

    <!-- Scene -->
    <LinearGradientBrush
        x:Key="TitanSceneBrush"
        StartPoint="50%,0%"
        EndPoint="50%,100%">
        <GradientStop Color="#a5a5bb" Offset="0"/>
        <GradientStop Color="#8e49d5" Offset="1"/>
    </LinearGradientBrush>

    <!-- Group -->
    <LinearGradientBrush
        x:Key="TitanGroupBrush"
        StartPoint="50%,0%"
        EndPoint="50%,100%">
        <GradientStop Color="#747474" Offset="0"/>
        <GradientStop Color="#313D3E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush
        x:Key="TitanSelectionMaskBrush"
        StartPoint="50%,0%"
        EndPoint="50%,100%">

        <GradientStop Color="#B0B0B0" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>

    </LinearGradientBrush>
</ResourceDictionary>

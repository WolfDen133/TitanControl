<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TitanControl.Controls.Common">

  <!--
    Additional resources 
    Using Control Themes:
         https://docs.avaloniaui.net/docs/basics/user-interface/styling/control-themes
    Using Theme Variants:
         https://docs.avaloniaui.net/docs/guides/styles-and-resources/how-to-use-theme-variants
  -->
  
  <Design.PreviewWith>
    <StackPanel Width="400" Spacing="10">      
        <StackPanel Background="{DynamicResource SystemRegionBrush}">
          <controls:NumericUpDown />
        </StackPanel>
    </StackPanel>
  </Design.PreviewWith>
 
  <ControlTheme x:Key="{x:Type controls:NumericUpDown}" TargetType="controls:NumericUpDown">
        <Setter Property="Background"
        Value="{DynamicResource BackgroundDBrush}" />

        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}" />

        <Setter Property="Foreground"
                Value="{DynamicResource ForegroundBrush}" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Setter Property="CornerRadius"
                Value="6" />

        <Setter Property="MinHeight"
                Value="34" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">

                    <Grid ColumnDefinitions="*,28">

                        <!-- Text editor -->

                        <TextBox
                            Name="PART_TextBox"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,0"
                            VerticalContentAlignment="Center"/>

                        <!-- Spinner -->

                        <Border
                            Grid.Column="1"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1,0,0,0">

                            <Grid RowDefinitions="*,*">

                                <RepeatButton
                                    Name="PART_IncreaseButton"
                                    Grid.Row="0"
                                    Background="Transparent"
                                    BorderThickness="0">

                                    <Svg
                                        Width="10"
                                        Height="10"
                                        CurrentColor="{DynamicResource Foreground}"
                                        Path="/Assets/Icons/arrow-up.svg" />

                                </RepeatButton>

                                <RepeatButton
                                    Name="PART_DecreaseButton"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0">

                                    <Svg
                                        Width="10"
                                        Height="10"
                                        CurrentColor="{DynamicResource Foreground}"
                                        Path="/Assets/Icons/arrow-down.svg" />

                                </RepeatButton>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>

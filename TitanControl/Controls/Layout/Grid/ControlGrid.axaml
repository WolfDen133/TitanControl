<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TitanControl.Controls.Layout"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TitanControl.Controls.Layout.ControlGrid"
             x:DataType="local:ControlGrid"
             x:Name="root"
             Background="{DynamicResource BackgroundDDBrush}">
  <Grid>
      <local:GridLayout x:Name="GridLayout" Background="Transparent" Columns="{Binding Columns, ElementName=root}" Rows="{Binding Rows, ElementName=root}"/>
      <local:GridLines IsHitTestVisible="False" Brush="{DynamicResource BorderSubtleBrush}" Columns="{Binding Columns, ElementName=root}" Rows="{Binding Rows, ElementName=root}"/>
      <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
           <Border x:Name="Selection" IsVisible="False" IsHitTestVisible="False" BorderBrush="{DynamicResource SelectionFocusBrush}" BorderThickness="1" Background="{DynamicResource SelectionTranslucentBrush}"/>
      </Canvas>
  </Grid>
</UserControl>

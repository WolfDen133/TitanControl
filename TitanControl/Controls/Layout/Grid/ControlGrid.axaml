<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:handle="using:TitanControl.Controls.Models.Handle"
             xmlns:handleControls="using:TitanControl.Controls.Handle"
             xmlns:local="using:TitanControl.Controls.Layout"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TitanControl.Controls.Layout.ControlGrid"
             x:Name="root"
             Background="{DynamicResource BackgroundDDBrush}">
        <UserControl.DataTemplates>
            <DataTemplate DataType="handle:HandleFaderModel">
                <handleControls:HandleFaderControl/>
            </DataTemplate>
            <DataTemplate DataType="handle:HandleButtonModel">
                <handleControls:HandleButtonControl/>
            </DataTemplate>
        </UserControl.DataTemplates>
  <Grid>
      <ItemsControl ItemsSource="{Binding #root.Controls}">
        <ItemsControl.ItemContainerTheme>
            <ControlTheme
                TargetType="ContentPresenter"
                x:CompileBindings="False">

                <Setter
                    Property="local:GridLayout.GridX"
                    Value="{Binding Location.X}" />

                <Setter
                    Property="local:GridLayout.GridY"
                    Value="{Binding Location.Y}" />

                <Setter
                    Property="local:GridLayout.GridXSpan"
                    Value="{Binding Location.Width}" />

                <Setter
                    Property="local:GridLayout.GridYSpan"
                    Value="{Binding Location.Height}" />

            </ControlTheme>
        </ItemsControl.ItemContainerTheme>
          <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                  <local:GridLayout 
                      x:Name="GridLayout" 
                      Background="Transparent" 
                      Columns="{Binding Columns, ElementName=root}" 
                      Rows="{Binding Rows, ElementName=root}"/>
              </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
      </ItemsControl>

      
      <local:GridLines IsHitTestVisible="False"
                       Brush="{DynamicResource BorderSubtleBrush}" 
                       Columns="{Binding Columns, ElementName=root}" 
                       Rows="{Binding Rows, ElementName=root}"/>

      <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
           <Border x:Name="Selection" 
                   IsVisible="False" 
                   IsHitTestVisible="False" 
                   BorderBrush="{DynamicResource SelectionFocusBrush}" 
                   BorderThickness="1" 
                   Background="{DynamicResource SelectionTranslucentBrush}"/>
      </Canvas>
  </Grid>
</UserControl>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "localInterface": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minLength": 4,
          "maxLength": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "scanDuration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "scanTimeout": {
      "type": "integer",
      "minimum": 50,
      "maximum": 1000
    },
    "scanPhaseDelay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "scanThreads": {
      "type": "integer",
      "maximum": 128,
      "minimum": 1
    },
    "scanHttps": {
      "type": "boolean"
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sessionId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "ipAddress": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "maxItems": 4,
                  "minItems": 4
                },
                "port": {
                  "type": "integer"
                },
                "portInteractive": {
                  "type": "integer"
                },
                "useHttps": {
                  "type": "boolean"
                },
                "reconnectAttempts": {
                  "type": "integer"
                },
                "keepAliveInterval": {
                  "type": "integer"
                },
                "autoTimeout": {
                  "type": "integer"
                }
              },
              "required": [ "sessionId", "name", "ipAddress", "port", "portInteractive", "useHttps", "reconnectAttempts", "keepAliveInterval", "autoTimeout" ]
            }
          }
        }
      }
    }
  },
  "required": ["sessions", "localInterface", "scanDuration", "scanTimeout", "scanPhaseDelay", "scanThreads", "scanHttps"]
}
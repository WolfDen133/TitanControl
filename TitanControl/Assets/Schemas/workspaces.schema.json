{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaces": {
      "type": "object",
      "patternProperties": {
        "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$": {
          "$ref": "#/$defs/workspaceEntry"
        }
      },
      "additionalProperties": false
    },
    "lastWorkspace": {
      "type": "string"
    }
  },
  "required": ["workspaces", "lastWorkspace"],
  "additionalProperties": false,
  "$defs": {
    "workspaceEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "additionalProperties": false
    }
  }
}
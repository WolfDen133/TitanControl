{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "lastModified": {
      "type": "string",
      "format": "date-time"
    },
    "options": {
      "type": "object",
      "properties": {
        "session": {
          "type": ["string", "null"]
        },
        "gridSize": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [ "session", "gridSize" ]
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "none",
              "fader",
              "button",
              "colorPicker"
            ]
          },
          "location": {
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "items": {
              "type": "integer"
            }
          },
          "titanId": {
            "type": "integer"
          },
          "handleType": {
            "type": "string",
            "enum": [
              "none",
              "fixtureHandle",
              "groupHandle",
              "cueHandle",
              "cueListHandle",
              "chaseHandle",
              "trackHandle",
              "paletteHandle",
              "macroHandle",
              "masterHandle",
              "abMasterHandle",
              "rateMasterHandle",
              "playbackGroupHandle"
            ]
          },
          "keyProfile": {
            "type": "string",
            "enum": [
              "none",
              "latch",
              "flash",
              "timedFlash",
              "go",
              "goBack",
              "release",
              "tapTempo"
            ]
          }
        },
        "required": [ "controlId", "location", "titanId", "handleType", "keyProfile" ]
      }
    }
  },
  "required": [ "workspaceId", "name", "lastModified", "options", "controls" ]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "lastModified": {
      "type": "string",
      "format": "date-time"
    },
    "settings": {
      "type": "object",
      "properties": {
        "session": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "gridSize": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [ "session", "gridSize" ]
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "controlId": {
            "type": "string",
            "enum": [
              "fader",
              "button",
              "colorPicker"
            ]
          },
          "location": {
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "items": {
              "type": "integer"
            }
          },
          "titanId": {
            "type": "integer"
          },
          "handleType": {
            "type": "string",
            "enum": [
              "fixtureHandle",
              "groupHandle",
              "cueHandle",
              "cueListHandle",
              "chaseHandle",
              "trackHandle",
              "paletteHandle",
              "macroHandle",
              "masterHandle",
              "abMasterHandle",
              "rateMasterHandle",
              "playbackGroupHandle"
            ]
          },
          "keyProfile": {
            "type": "string",
            "enum": [
              "Latch",
              "Flash",
              "TimedFlash",
              "Go",
              "GoBack",
              "Release",
              "TapTempo"
            ]
          }
        },
        "required": [ "controlId", "location", "titanId", "handleType", "keyProfile" ]
      }
    }
  },
  "required": ["workspaceId", "name", "lastModified", "settings"]
}
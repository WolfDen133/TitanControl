<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20" Background="{DynamicResource BackgroundLBrush}">
        <StackPanel Width="200" Spacing="5">
            <TextBox PlaceholderText="TextInput"/>
            <NumericUpDown Value="20"/>
            <Button Content="Button"/>
            <CheckBox/>
        </StackPanel>
      
    </Border>
  </Design.PreviewWith>

  <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource BackgroundDBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource BackgroundDBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource BackgroundLBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
    <Style Selector="CheckBox">
      <Setter Property="Background" Value="{DynamicResource BackgroundDBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="using:TitanControl.Controls.Common">
  <Design.PreviewWith>
    <Border Padding="20">
      <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>

  <Style Selector="Border.running">
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="RenderTransform">
        <RotateTransform Angle="360"/>
    </Setter>

    <Style.Animations>
        <Animation Duration="0:0:1.5"
                   
                   IterationCount="INFINITE"
                   Easing="CubicEaseInOut">

            <KeyFrame Cue="0%">
                <Setter Property="RotateTransform.Angle"
                        Value="360"/>
            </KeyFrame>

            <!-- Hold for another 0.5 seconds -->
            <KeyFrame Cue="100%">
                <Setter Property="RotateTransform.Angle"
                        Value="0"/>
            </KeyFrame>
        </Animation>
    </Style.Animations>
    </Style>
    <Style Selector="Border.running-inverse">
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="RenderTransform">
            <RotateTransform Angle="0"/>
        </Setter>
        <Style.Animations>
             <Animation Duration="0:0:1.5"
                   IterationCount="INFINITE">

            <KeyFrame Cue="0%">
                <Setter Property="RotateTransform.Angle"
                        Value="0"/>
            </KeyFrame>

            <!-- Hold for another 0.5 seconds -->
            <KeyFrame Cue="100%">
                <Setter Property="RotateTransform.Angle"
                        Value="360"/>
            </KeyFrame>
        </Animation>
        </Style.Animations>
    </Style>
</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="Title" Classes="title"/>
            <TextBlock Text="Subtitle" Classes="subtitle"/>
            <TextBlock Text="Body"/>
            <TextBlock Text="Header 1" Classes="h1"/>
            <TextBlock Text="Header 2" Classes="h2"/>
            <TextBlock Text="Header 3" Classes="h3"/>
            <TextBlock Text="Header 4" Classes="h4"/>
        </StackPanel>
        
    </Border>
  </Design.PreviewWith>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="fonts:Inter#Inter"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="24"/>
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="22"/>
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="TextBlock.h4">
        <Setter Property="FontWeight" Value="SemiLight"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
</Styles>

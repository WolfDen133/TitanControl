<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:layout="using:TitanControl.Controls.Layout"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:page="using:TitanControl.ViewModels.Page"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TitanControl.Views.Pages.WorkspacePage"
             x:DataType="page:WorkspacePageModel">
  <layout:ControlGrid x:Name="PART_ControlGrid" Controls="{Binding Controls}"/>
</UserControl>

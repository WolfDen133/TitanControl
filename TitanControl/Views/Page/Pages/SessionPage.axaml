                    <layout:Section.FooterContent>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <common:IconButton Text="Save Changes" BorderBrush="{DynamicResource SuccessBrush}" Command="{Binding SaveSessionCommand}">
                                <common:IconButton.Icon>
                                    <Svg SvgSource="{StaticResource DiskSvgSource}" CurrentColor="{DynamicResource SuccessColorL}"/>
                                </common:IconButton.Icon>
                            </common:IconButton>
                            <common:IconButton Text="Cancel" BorderBrush="{DynamicResource DangerBrush}" Command="{Binding CancelCommand}">
                                <common:IconButton.Icon>
                                    <Svg SvgSource="{StaticResource CancelSvgSource}" CurrentColor="{DynamicResource DangerColorL}"/>
                                </common:IconButton.Icon>
                            </common:IconButton>
                        </StackPanel>
                    </layout:Section.FooterContent>
                </layout:Section>
                <layout:Section Grid.Column="2" Title="Current session" Subtitle="Currently selected or connected session">
                    <layout:Section.Icon>
                        <common:TwoToneSvg SvgSource="{StaticResource StatisticSvgSource}" PrimaryColor="{DynamicResource Foreground}" SecondaryColor="{DynamicResource AccentColor}"/>
                    </layout:Section.Icon>
                    <Grid RowDefinitions="Auto, *, Auto">
                        <Border CornerRadius="10"
                                Padding="20"
                                BorderBrush="{Binding SelectedSession?.State, Converter={StaticResource SessionStatusToBrushConverter}, ConverterParameter=0.3}" 
                                BorderThickness="1" 
                                Background="{Binding SelectedSession?.State, Converter={StaticResource SessionStatusToBrushConverter}, ConverterParameter=0.1}">
                            <StackPanel Spacing="10">
                                <Grid RowDefinitions="Auto, *" RowSpacing="8">
                                    <StackPanel Spacing="10" Orientation="Horizontal">
                                        <Ellipse Width="15" Height="15" Fill="{Binding SelectedSession?.State, Converter={StaticResource SessionStatusToBrushConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Classes="value" Foreground="{Binding SelectedSession?.State, Converter={StaticResource SessionStatusToBrushConverter}}" Text="{Binding SelectedSession?.State}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Classes="context" Foreground="{DynamicResource ForegroundSecondaryBrush}">
                                        <Run>Since</Run>
                                        <Run Text="{Binding SelectedSession?.ConnectedAt, StringFormat={}{0:dd/MM HH:mm}}"/>
                                    </TextBlock>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Classes="h1" Text="{Binding SelectedSession?.Name}" Padding="0 2"/>
                                        <TextBlock Classes="h3" Text="{Binding Endpoint}" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Padding="10 15">
                            <StackPanel Spacing="15">
                                <UniformGrid Rows="9" Columns="2" RowSpacing="10">
                                    <UniformGrid.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </UniformGrid.Styles>
                                    <TextBlock Text="Status" Classes="meta"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedSession?.State}" Foreground="{Binding SelectedSession?.State, Converter={StaticResource SessionStatusToBrushConverter}}" Classes="value"/>
                                    <TextBlock Text="IP Address" Classes="meta"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedSession?.IPAddress, TargetNullValue='0.0.0.0'}" Classes="value"/>
                                    <TextBlock Text="Connection Port" Classes="meta"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedSession?.Port, TargetNullValue='-'}" Classes="value"/>
                                    <TextBlock Text="Interactive Port" Classes="meta"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedSession?.PortInteractive, TargetNullValue='Unavailable'}" Classes="value"/>
                                    <TextBlock Text="Auto Timeout Duration" Classes="meta"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedSession?.AutoTimeout, TargetNullValue='Never', StringFormat={}{0:0 minuate(s)}}" Classes="value"/>
                                    <TextBlock Text="Keep Alive Interval" Classes="meta"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedSession?.KeepAlive, TargetNullValue='-', StringFormat={}{0:0 second(s)}}" Classes="value"/>
                                    <TextBlock Text="Reconnect Attempts" Classes="meta"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedSession?.ReconnectIterations, TargetNullValue='None', StringFormat={}{0:0 attempt(s)}}" Classes="value"/>
                                    <TextBlock Text="SSL / TLS (HTTPS)" Classes="meta"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedSession?.UseHttps, Converter={StaticResource BoolToStateConverter}, ConverterParameter=Encrypted}" Classes="value"/>
                                    <TextBlock Text="Computer Name" Classes="meta"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedSession?.ComputerName, TargetNullValue='-'}" Classes="value"/>
                                </UniformGrid>                        
                                <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*, *" ColumnSpacing="10">
                                    <common:IconButton Text="Connect" Foreground="{DynamicResource SuccessLBrush}" BorderBrush="{DynamicResource SuccessDBrush}" Command="{Binding ConnectCommand}">
                                        <common:IconButton.Icon>
                                            <Svg SvgSource="{StaticResource ConnectSvgSource}" CurrentColor="{DynamicResource SuccessColorL}"/>
                                        </common:IconButton.Icon>
                                    </common:IconButton>
                                    <common:IconButton Grid.Column="1" Text="Disconnect" Foreground="{DynamicResource DangerLBrush}" BorderBrush="{DynamicResource DangerDBrush}" Command="{Binding DisconnectCommand}">
                                        <common:IconButton.Icon>
                                            <Svg SvgSource="{StaticResource DisconnectSvgSource}" CurrentColor="{DynamicResource DangerColorL}"/>
                                        </common:IconButton.Icon>
                                    </common:IconButton>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}"/>
                                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10"> 
                                    <Border CornerRadius="10" ClipToBounds="True">
                                        <Grid RowDefinitions="Auto, *">
                                            <Border Background="{DynamicResource BackgroundLLBrush}" Padding="10">
                                                <TextBlock Classes="h3" Text="Workspace Session"/>
                                            </Border>
                                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding EnabledSessions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Background="{DynamicResource BackgroundDBrush}"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="15" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0 1 0 0">
                                                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                                                    <Ellipse VerticalAlignment="Center" Width="10" Height="10" Fill="{Binding State, Converter={StaticResource SessionStatusToBrushConverter}}"/>
                                                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                                                        <TextBlock Classes="h2" FontWeight="SemiBold" Text="{Binding Name}"/>
                                                                        <TextBlock Classes="h3" Text="{Binding IPAddress}"/>
                                                                    </StackPanel>
                                                                    <Panel Grid.Column="2" Cursor="Hand">
                                                                        <common:TwoToneSvg 
                                                                            SvgSource="{StaticResource AssignedSvgSource}" 
                                                                            IsVisible="{Binding, Converter={StaticResource IsSessionAssignedToWorkspaceConverter}, ConverterParameter={Binding #SessionPageRoot.DataContext.CurrentWorkspace}}" 
                                                                            Height="32"
                                                                            PrimaryColor="{DynamicResource Foreground}" SecondaryColor="{DynamicResource SuccessColor}"/>
                                                                        <common:TwoToneSvg 
                                                                            SvgSource="{StaticResource UnassignedSvgSource}" 
                                                                            IsVisible="{Binding, Converter={StaticResource InvertedSessionAssignedToWorkspaceConverter}, ConverterParameter={Binding #SessionPageRoot.DataContext.CurrentWorkspace}}" 
                                                                            Height="32"                                                                        
                                                                            PrimaryColor="{DynamicResource Foreground}" SecondaryColor="{DynamicResource SuccessColor}"/>

                                                                    </Panel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Border>
                                
                            </StackPanel>
                        </Border>
                    </Grid>
                    <layout:Section.FooterContent>
                        <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*, *, *" ColumnSpacing="10" >
                                    <common:IconButton Text="Edit" Command="{Binding EditCommand}">
                                        <common:IconButton.Icon>
                                            <Svg SvgSource="{StaticResource PenSvgSource}" CurrentColor="{DynamicResource AccentColorL}"/>
                                        </common:IconButton.Icon>
                                    </common:IconButton>
                                    <common:IconButton Grid.Column="1" Text="Duplicate" Command="{Binding DuplicateCommand}">
                                        <common:IconButton.Icon>
                                            <Svg SvgSource="{StaticResource CopySvgSource}" CurrentColor="{DynamicResource Foreground}"/>
                                        </common:IconButton.Icon>
                                    </common:IconButton>
                                    <common:IconButton Grid.Column="2" Text="Remove" Foreground="{DynamicResource DangerLBrush}" BorderBrush="{DynamicResource DangerBrush}" Command="{Binding RemoveCommand}">
                                        <common:IconButton.Icon>
                                            <Svg SvgSource="{StaticResource DeleteSvgSource}" CurrentColor="{DynamicResource DangerColorL}"/>
                                        </common:IconButton.Icon>
                                    </common:IconButton>
                                </Grid>
                    </layout:Section.FooterContent>
                </layout:Section>
            </Grid>
        </Grid>
    </Border>
</UserControl>

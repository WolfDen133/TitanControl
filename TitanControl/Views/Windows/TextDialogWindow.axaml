<Window xmlns="https://github.com/avaloniaui"
        xmlns:control="using:TitanControl.Views.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:TitanControl.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="TitanControl.Views.TextDialogWindow"
        x:DataType="local:TextDialogWindow"
        Width='380'
        Height="220"
        CanResize="False"
        ShowInTaskbar="False"
        CanMinimize="False"
        CanMaximize="false"
        Topmost="True"
        Background="{DynamicResource BackgroundLBrush}"
        WindowStartupLocation="CenterOwner">
        <Border Padding="15 10 15 5">
            <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="10">
                <TextBlock Classes="h2" Text="{Binding Heading}"/>
                <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Padding="10">
                    <TextBlock Classes="value" Text="{Binding Text}" TextWrapping="Wrap"/>
                </Border>
                <Border Grid.Row="2">
                    <TextBox Text="{Binding Value}"/>
                </Border>
                <Grid ColumnDefinitions="*, *" Grid.Row="3" ColumnSpacing="10">
                    <control:IconButton x:Name="TextYes" Text="Accept" Command="{Binding TextAcceptCommand}" BorderBrush="{DynamicResource SuccessBrush}">
                        <control:IconButton.Icon>
                            <Svg SvgSource="{StaticResource TickSource}" CurrentColor="{DynamicResource SuccessColorL}"/>
                        </control:IconButton.Icon>
                    </control:IconButton>
                    <control:IconButton x:Name="TextNo" Text="Decline" Grid.Column="1" BorderBrush="{DynamicResource DangerBrush}" Command="{Binding TextDeclineCommand}" IsEnabled="True">
                        <control:IconButton.Icon>
                            <Svg SvgSource="{StaticResource CrossSource}" CurrentColor="{DynamicResource DangerColorL}"/>
                        </control:IconButton.Icon>
                    </control:IconButton>
                </Grid>
            </Grid>
        </Border>
</Window>
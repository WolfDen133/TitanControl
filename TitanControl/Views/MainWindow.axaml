<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:layout="using:TitanControl.Controls.Layout"
        xmlns:local="using:TitanControl"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="using:TitanControl.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="1515"
        MinHeight="850"
        x:Class="TitanControl.MainWindow"
        x:DataType="viewmodels:MainWindowModel"
        Title="TitanControl">
    <Grid Background="{DynamicResource BackgroundDDBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:Toolbar x:Name="PART_Toolbar" VerticalAlignment="Top"/>
        <Grid Grid.Row="1" x:Name="PART_ContentGrid"/>
    </Grid>
</Window>

    <FontFamily x:Key="Font-M">resm:TitanControl.Assets.Fonts#Dubai-Medium</FontFamily>
    <FontFamily x:Key="Font-L">resm:TitanControl.Assets.Fonts#Dubai-Light</FontFamily>
    <FontFamily x:Key="Font-H">resm:TitanControl.Assets.Fonts#Dubai-Bold</FontFamily>

